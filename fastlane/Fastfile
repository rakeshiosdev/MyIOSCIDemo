default_platform(:ios)

platform :ios do

  desc "Run SwiftLint"
  lane :lint do
    swiftlint(
      mode: :lint,
      path: "MyIOSCIDemo",
      strict: true
    )
  end

  desc "Run unit tests"
  lane :test do
    run_tests(
      scheme: "MyIOSCIDemo",
      devices: ["iPhone 17"],
      clean: false,
      code_coverage: false,
      result_bundle: false
    )
  end

  desc "Run lint and tests"
  lane :ci do
    puts "🔍 Running SwiftLint..."
    lint

    puts "🧪 Running unit tests..."
    test

    puts "✅ CI checks passed!"
  end

  desc "Build and upload to TestFlight"
  lane :beta do

    puts "🔐 Authenticating with App Store Connect..."

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY"]
    )

    puts "🔐 Fetching certificates and provisioning profiles..."

    match(
      type: "appstore",
      api_key: api_key,
      readonly: true
    )

    puts "🔎 Getting latest TestFlight build number..."

    latest_build = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "YOUR_BUNDLE_IDENTIFIER"
    )

    next_build = latest_build + 1

    puts "📦 Current TestFlight build: #{latest_build}"
    puts "🚀 Next build: #{next_build}"

    increment_build_number(
      build_number: next_build,
      xcodeproj: "MyIOSCIDemo.xcodeproj"
    )

    puts "🏗️ Building #{next_build}..."

    build_app(
      scheme: "MyIOSCIDemo",
      export_method: "app-store"
    )

    puts "📤 Uploading build #{next_build} to TestFlight..."

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )

    puts "✅ TestFlight build #{next_build} uploaded successfully!"

  end

end